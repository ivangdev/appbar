# =============================================================================
# Caddyfile — Reverse proxy para produccion (Dokploy / VPS con HTTPS)
#
# Reemplaza {$DOMAIN} por tu dominio real (o define DOMAIN en el entorno).
# Caddy obtiene TLS automaticamente (Let's Encrypt).
#
# Enrutamiento:
#   /ws/*      -> backend  (WebSocket: NO pasa por el proxy de Next)
#   /health*   -> backend  (liveness/readiness para monitoreo)
#   /*         -> frontend (Next reenvia /api/* al backend server-side)
# =============================================================================

{$DOMAIN:pos.localhost} {
	encode zstd gzip

	# Headers de seguridad (el backend esta detras de este proxy).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# WebSocket de mesas (handshake con cookie HttpOnly).
	@ws path /ws/*
	handle @ws {
		reverse_proxy backend:8000
	}

	# Salud del backend (util para uptime checks y load balancers).
	@health path /health /health/*
	handle @health {
		reverse_proxy backend:8000
	}

	# Todo lo demas lo sirve Next.js (incluye /api/* que Next proxya al backend).
	handle {
		reverse_proxy frontend:3000
	}
}

# =============================================================================
# Tunel saliente (Serveo) — alternativa cuando el router no permite abrir
# puertos. Serveo termina TLS y envia HTTP plano a este host; por eso se
# declara con http:// (auto_https desactivado para este site).
# El ruteo es identico al del dominio principal.
# =============================================================================
http://posbar-app-bar.serveo.net {
	@ws path /ws/*
	handle @ws {
		reverse_proxy backend:8000
	}

	@health path /health /health/*
	handle @health {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}

# Catch-all HTTP para tuneles sin dominio propio (Cloudflare Quick Tunnel):
# cualquier Host que llegue por el puerto 80 se enruta igual que el principal.
http:// {
	@ws path /ws/*
	handle @ws {
		reverse_proxy backend:8000
	}

	@health path /health /health/*
	handle @health {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
