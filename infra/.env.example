# =============================================================================
# .env.example — Plantilla de variables de entorno (POS Bar)
#
# COMO USAR:  cp .env.example .env   (dev local)
# El archivo .env REAL nunca se commitea (esta en .gitignore).
# Las mismas variables se definen en Dokploy (produccion) via "Environment".
# =============================================================================

# ------------------------- Entorno -------------------------
# development | production. En production la app falla al arrancar si detecta
# secretos de ejemplo, COOKIE_SECURE=False o SEED_DEMO_USERS=True.
APP_ENV=development

# ------------------------- PostgreSQL (BD) -------------------------
POSTGRES_DB=pos_bar
POSTGRES_USER=pos_user
# Cambia esta password (obligatorio en produccion).
POSTGRES_PASSWORD=cambia_esta_password_en_produccion
# Puerto expuesto en la maquina local (dev).
POSTGRES_PORT=5432
# Host para conectarse DESDE el backend en dev.
# - Dev (backend en tu maquina, db en docker) -> localhost
# - Produccion (backend y db en la red de Dokploy) -> nombre del servicio, ej: db
POSTGRES_HOST=localhost

# ------------------------- Backend — JWT -------------------------
# Secreto con el que se firma y verifica el JWT (HS256).
# Debe ser largo y aleatorio:  openssl rand -hex 32
JWT_SECRET=cambia_este_secreto_por_uno_aleatorio_largo
JWT_ALGORITHM=HS256
# Duracion del token en horas (decision: 24h, sin refresh).
ACCESS_TOKEN_EXPIRE_HOURS=24
# Cookie Secure: False en dev (http localhost); True en produccion (HTTPS/WSS).
COOKIE_SECURE=False

# ------------------------- Rate limiting (slowapi) -------------------------
RATE_LIMIT_ENABLED=True

# ------------------------- Seed inicial (idempotente al arrancar) -------------------------
# Admin que se crea si su email no existe. En produccion cambia la password.
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=admin@posbar.com
INITIAL_ADMIN_PASSWORD=admin12345
# Solo dev: crea tambien el mesero de ejemplo. En produccion debe ser False.
SEED_DEMO_USERS=True
INITIAL_WAITER_NAME=Mesero
INITIAL_WAITER_EMAIL=mesero@posbar.com
INITIAL_WAITER_PASSWORD=mesero12345

# ------------------------- Frontend -------------------------
# URL publica que el NAVEGADOR usara para el WebSocket del tablero de mesas.
# - Dev local: http://localhost:8000
# - Produccion (mismo origen tras Caddy): dejar VACIO para usar el origin actual.
# Es BUILD-TIME: cambiarla exige rebuild de la imagen.
NEXT_PUBLIC_API_URL=http://localhost:8000
# URL interna server-side para el proxy /api/* de Next. La fija compose en el
# build (http://backend:8000); en Dokploy, si construyes fuera de compose,
# pasala como build arg.

# ------------------------- Caddy (profile "proxy") -------------------------
# Dominio publico para TLS automatico. En dev local: pos.localhost
DOMAIN=pos.localhost
