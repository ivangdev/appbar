# =============================================================================
# .env.example — Plantilla de variables de entorno (POS Bar)
#
# COMO USAR:  cp .env.example .env   (dev local)
# El archivo .env REAL nunca se commitea (esta en .gitignore).
# Las mismas variables se definen en Dokploy (produccion) via "Environment".
# =============================================================================

# ------------------------- PostgreSQL (BD) -------------------------
# Usadas por docker-compose para crear la base, el usuario y la password
# del contenedor de PostgreSQL 16.
POSTGRES_DB=pos_bar
POSTGRES_USER=pos_user
POSTGRES_PASSWORD=cambia_esta_password_en_produccion
# Puerto expuesto en la maquina local (dev). 5432 es el default de Postgres.
POSTGRES_PORT=5432
# Host para conectarse DESDE el backend en dev.
# - Dev (backend en tu maquina, db en docker) -> localhost
# - Produccion (backend y db en la red de Dokploy) -> nombre del servicio, ej: db
POSTGRES_HOST=localhost

# ------------------------- Backend — JWT (Fase 2) -------------------------
# Secreto con el que se firma y verifica el token JWT (HS256).
# Debe ser largo y aleatorio. Genera uno:  openssl rand -hex 32
JWT_SECRET=cambia_este_secreto_por_uno_aleatorio_largo
JWT_ALGORITHM=HS256
# Duracion del token en horas (decision: 24h, sin refresh).
ACCESS_TOKEN_EXPIRE_HOURS=24
# Cookie Secure: False en dev (http localhost); True en produccion (HTTPS/WSS).
COOKIE_SECURE=False

# ------------------------- Rate limiting (slowapi) -------------------------
# Activa el limite por IP en endpoints sensibles. Los tests lo desactivan solos.
RATE_LIMIT_ENABLED=True

# ------------------------- Frontend (Fase 6) -------------------------
# URL publica que el NAVEGADOR usara para el WebSocket del tablero de mesas.
# - Dev local: http://localhost:8000
# - Produccion (mismo origen tras Caddy): dejar VACIO para usar el origin actual.
NEXT_PUBLIC_API_URL=http://localhost:8000